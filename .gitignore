# Obsidian per-machine workspace state (changes on every open; not portable)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace

# Obsidian cache / leftovers
.obsidian/cache
.obsidian/plugins/*/cache
# Per-machine plugin UI state (outline expansion, scroll offsets, cursors)
.obsidian/plugins/obsidian-quiet-outline/markdown-states.json

# Obsidian Git settings — stores the Git username and personal access token in
# plain text, so it must never be committed to a public repository.
.obsidian/plugins/obsidian-git/data.json

# Dictionary plugin: lookup cache is machine state, and its note folder only
# holds autogenerated dictionary entries for random words, not course notes.
.obsidian/plugins/obsidian-dictionary-plugin/cache.json
en-US/

.trash/
.DS_Store
Thumbs.db
desktop.ini

# The remotely-save plugin bundle ships with hardcoded upstream Google OAuth
# credentials, which GitHub push protection rejects. Install it from Obsidian's
# community plugin browser instead:
# https://github.com/remotely-save/remotely-save
.obsidian/plugins/remotely-save/

# OS / editor noise
*.swp
*~
.idea/
.vscode/
# Excalidraw auto-names new untitled canvases 'Drawing <timestamp>'; those are
# scratch files. Rename a drawing you want to keep versioned.
Excalidraw/Drawing *.excalidraw.md

# A second, default Obsidian config is created here if you open the inner
# notes folder as its own vault. Open the repository ROOT as the vault.
Software-Engineering-Vault/.obsidian/
